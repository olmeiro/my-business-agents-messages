# Copia este archivo como .env y rellena tus claves:
#   PowerShell:  Copy-Item .env.template .env
#   Bash:        cp .env.template .env
# El archivo .env NUNCA se sube a git (está en .gitignore): ahí van tus claves privadas.

# Qué modelo usa el agente: nvidia | groq   (si lo dejas vacío, usa groq)
LLM_PROVIDER=nvidia

# Solo necesitas la clave del proveedor que elegiste arriba.
# NVIDIA: https://build.nvidia.com/nvidia/nemotron-3.5-super-vl-120b-a12b  -> botón "Get API Key"
NVIDIA_API_KEY=nvapi-tu-clave-aqui
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=gsk_tu-clave-aqui

# --- Opcionales (quita el # para usarlos) ---
# Razonamiento de Nemotron: none (responde directo, más barato) | low | high (piensa antes, más tokens)
# NVIDIA_REASONING_EFFORT=none
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# GROQ_MODEL=openai/gpt-oss-20b
# PORT=3000
