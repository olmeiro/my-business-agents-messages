{
  "openapi": "3.1.0",
  "info": {
    "title": "Weather Agent",
    "version": "1.1.0",
    "description": "Agente conversacional (LangGraph + Groq o NVIDIA, según LLM_PROVIDER) con una herramienta de clima (Open-Meteo). Mantiene memoria por threadId mientras el servidor está encendido y devuelve los tokens consumidos."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/report": {
      "post": {
        "summary": "Informe del clima en JSON estructurado",
        "description": "Ejemplo de structured output: consulta el clima real y el modelo devuelve un JSON que cumple el esquema WeatherReport (validado con zod). Sin memoria ni herramientas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["city"],
                "properties": { "city": { "type": "string", "minLength": 1, "maxLength": 100 } }
              },
              "example": { "city": "Bogotá" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Informe estructurado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["report", "usage"],
                  "properties": { "report": { "$ref": "#/components/schemas/WeatherReport" }, "usage": { "$ref": "#/components/schemas/Usage" } }
                }
              }
            }
          },
          "400": { "description": "Falta city o el JSON es inválido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Ciudad no encontrada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "502": { "description": "Fallo al consultar el modelo", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Enviar un mensaje al agente",
        "description": "Sin threadId inicia una conversación nueva y devuelve su threadId. Envía ese threadId en los siguientes mensajes para continuarla.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "examples": {
                "nueva": { "summary": "Conversación nueva", "value": { "message": "¿Qué tiempo hace en Bogotá?" } },
                "continuar": { "summary": "Continuar conversación", "value": { "message": "¿Y comparado con Cartagena?", "threadId": "4939598e-8563-4df3-aa99-514dd9d2d1a1" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta del agente",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatResponse" } } }
          },
          "400": {
            "description": "Body inválido (JSON mal formado, falta message o threadId con formato incorrecto)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "Fallo al consultar el modelo (Groq)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WeatherReport": {
        "type": "object",
        "description": "Salida estructurada: el modelo está obligado a devolver exactamente esta forma (response_format: json_schema).",
        "required": ["city", "country", "temperatureC", "condition", "feeling", "umbrellaNeeded", "recommendation"],
        "properties": {
          "city": { "type": "string", "example": "Bogotá" },
          "country": { "type": "string", "example": "Colombia" },
          "temperatureC": { "type": "number", "example": 17.3 },
          "condition": { "type": "string", "example": "Llovizna ligera" },
          "feeling": { "type": "string", "enum": ["frío", "fresco", "templado", "caluroso"] },
          "umbrellaNeeded": { "type": "boolean", "example": true },
          "recommendation": { "type": "string", "example": "Lleva paraguas y una chaqueta ligera." }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1, "description": "Mensaje del usuario" },
          "threadId": { "type": "string", "pattern": "^[\\w-]{1,100}$", "description": "Id de conversación devuelto en una respuesta anterior" }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": ["reply", "threadId", "usage"],
        "properties": {
          "reply": { "type": "string", "description": "Respuesta del agente (puede venir en Markdown)" },
          "threadId": { "type": "string", "description": "Id para continuar la conversación" },
          "usage": { "$ref": "#/components/schemas/Usage" }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Tokens consumidos en este turno, sumando todas las llamadas al modelo (si usó la herramienta son 2). La entrada de cada llamada incluye el historial de la conversación.",
        "required": ["inputTokens", "outputTokens"],
        "properties": {
          "inputTokens": { "type": "integer", "example": 898 },
          "outputTokens": { "type": "integer", "example": 422 }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
